      "changelog": [
        {
          "version": "1.3.118",
          "tag": "v1.3.118",
          "published_at": "2026-11-24T03:52:48Z",
          "html_url": "https://github.com/blockmd-plugins/block-sync/releases/tag/v1.3.118",
          "zh": {
            "new": [
              "同步通知现已采用应用右上角横幅的形式展示，并提供直达插件设置的快捷入口。"
            ],
            "other": [
              "插件移除了多余的存储与通知权限申请，进一步精简了运行所需的系统权限。"
            ]
          },
          "en": {
            "new": [
              "Sync now displays notifications as an in-app banner in the top-right corner, complete with a direct shortcut to plugin settings."
            ],
            "other": [
              "The plugin no longer requests unnecessary storage and notification permissions, reducing the access privileges required to run."
            ]
          }
        },
        {
          "version": "1.3.116",
          "tag": "v1.3.116",
          "published_at": "2026-11-23T17:17:38Z",
          "html_url": "https://github.com/blockmd-plugins/block-sync/releases/tag/v1.3.116",
          "zh": {
            "new": [
              "同步现在会将删除操作传播到本地目录、镜像目录、Git 仓库和 WebDAV 目标。",
              "同步现在会将同步活动记录到 Block 的活动日志中。"
            ],
            "fixes": [
              "保存配置时，同步现在会阻止关闭唯一启用的目标。"
            ],
            "other": [
              "同步在商店中的分类现为「工具」。"
            ]
          },
          "en": {
            "new": [
              "Sync now propagates deletions across local folders, mirror directories, Git repositories, and WebDAV targets.",
              "Sync now records its activity in Block’s activity log."
            ],
            "fixes": [
              "Sync now prevents you from disabling the only enabled target when saving its configuration."
            ],
            "other": [
              "Sync’s store listing is now classified under Tools."
            ]
          }
        },
        {
          "version": "1.3.110",
          "tag": "v1.3.110",
          "published_at": "2026-11-22T06:59:24Z",
          "html_url": "https://github.com/blockmd-plugins/block-sync/releases/tag/v1.3.110",
          "zh": {
            "fixes": [
              "对于尚未完成配置的同步目标，同步界面不再显示最近同步活动卡片。"
            ]
          },
          "en": {
            "fixes": [
              "Sync now hides the recent sync activity card for sync targets that have not been configured."
            ]
          }
        },
        {
          "version": "1.3.109",
          "tag": "v1.3.109",
          "published_at": "2026-11-22T06:26:35Z",
          "html_url": "https://github.com/blockmd-plugins/block-sync/releases/tag/v1.3.109",
          "zh": {
            "fixes": [
              "每个同步目标标签页现在独立展示各自的最近同步活动，不同目标的记录不再相互混杂。"
            ]
          },
          "en": {
            "fixes": [
              "Sync now displays recent sync activity separately within each sync target tab, preventing records from different targets from mixing together."
            ]
          }
        },
        {
          "version": "1.3.108",
          "tag": "v1.3.108",
          "published_at": "2026-11-22T06:18:39Z",
          "html_url": "https://github.com/blockmd-plugins/block-sync/releases/tag/v1.3.108",
          "zh": {
            "new": [
              "同步插件现已支持同时向多个目标执行同步，并为各个通道独立显示实时进度。"
            ],
            "fixes": [
              "同步插件现会在保存设置时拦截清空唯一同步目标的操作，防止所有同步目的地被意外移除。"
            ]
          },
          "en": {
            "new": [
              "Sync now supports simultaneous synchronization across multiple targets and displays independent real-time progress for each channel."
            ],
            "fixes": [
              "Sync now rejects saving configuration changes that would clear the only remaining sync target, preventing all destinations from being accidentally removed."
            ]
          }
        }
      ]
    },
